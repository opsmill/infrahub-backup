{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Neo4j importer options",
  "type": "object",
  "properties": {
    "location": { "type": "string", "description": "neo4j://[user:pass@]host:6362/<db> or neo4j+offline:///<datadir>?database=<db>" },
    "host": { "type": "string" },
    "port": { "type": "string", "description": "Enterprise backup-service port (default 6362)" },
    "username": { "type": "string" },
    "password": { "type": "string" },
    "database": { "type": "string", "description": "Database name (default: neo4j)" },
    "data_dir": { "type": "string", "description": "Neo4j data/home directory (offline only)" },
    "neo4j_admin_path": { "type": "string", "description": "Path to the neo4j-admin binary" },
    "neo4j_bin_dir": { "type": "string", "description": "Directory containing neo4j-admin (else $PATH)" }
  },
  "additionalProperties": false
}
